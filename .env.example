# Copy to .env (ignored by git) and set your own values. NEVER commit .env.
SPRING_PROFILES_ACTIVE=dev
DB_NAME=orders
DB_USER=orders_user
DB_PASSWORD=change-me
API_PORT=8080
JENKINS_ADMIN_PASSWORD=change-me
GITHUB_TOKEN=ghp_example
USE_GITHUB_WEBHOOK=false
JENKINS_PUBLIC_URL=http://localhost:8080/
# Rama que construye el job (por defecto */master)
JENKINS_BRANCH=*/master
# Para webhooks: USE_GITHUB_WEBHOOK=true y JENKINS_PUBLIC_URL=https://<tunel>/
# (ngrok/smee.io apuntando a http://localhost:8080/github-webhook/)
# GID del grupo dueño de /var/run/docker.sock: Linux -> getent group docker | cut -d: -f3 ; Docker Desktop -> 0
DOCKER_GID=984

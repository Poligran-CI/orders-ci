# Copy to .env (ignored by git) and set your own values. NEVER commit .env.
SPRING_PROFILES_ACTIVE=dev
DB_NAME=orders
# Database user/password: used by docker compose and, in Jenkins, by the "orders-db" credential
DB_USER=orders_user
DB_PASSWORD=change-me
API_PORT=8080

# Jenkins
JENKINS_ADMIN_PASSWORD=change-me
JENKINS_PUBLIC_URL=http://localhost:8080/
# Branch built by the job (default */master)
JENKINS_BRANCH=*/master
# GID of the group that owns /var/run/docker.sock: Linux -> getent group docker | cut -d: -f3 ; Docker Desktop -> 0
DOCKER_GID=984
